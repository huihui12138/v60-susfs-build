# ============================================================
# LG V60 ThinQ (timelm) - stock Android 13 - Kernel 4.19.113
# SUSFS + OFFICIAL KernelSU v0.9.5 build profile   <-- matched-version rebuild
# For: 5kind/Droidspaces_Action  (/.github/workflows/build-kernel.yml)
# Place this file at: config/v60_stock_a13.env in the forked Action repo
#
# WHY v0.9.5 (changed from sukisu-ultra/builtin):
#   susfs4ksu's kernel-4.19 branch ships SUSFS v1.5.5 (old API, frozen early
#   2025) written for the OLD FLAT KernelSU layout. SukiSU-Ultra builtin is
#   v3.0.0 and calls NEW SUSFS APIs (CMD_SUSFS_ADD_SUS_MAP, susfs_enable_log,
#   ...), which do not exist in 1.5.5 -> 18 rounds of API-mismatch failures.
#   Official KernelSU v0.9.5 has the matching flat kernel/ layout and is the
#   version SUSFS 1.5.5 was designed for. The Action will apply the
#   KernelSU-side SUSFS patch (bundled refs = '-' for this variant).
#   NOTE: UAPI becomes 11872 -> use KernelSU_v0.9.5_11872 manager after flash.
# ============================================================

# --- Kernel source (stock-based Rofik tree, same base as current boot) ---
KERNEL_SOURCE=https://github.com/rofikkerneldev/kernel_lgv600tm_4.19
KERNEL_SOURCE_BRANCH=main
KERNEL_CONFIG=vendor/timelm_defconfig
KERNEL_IMAGE_NAME=Image.gz-dtb
ARCH=arm64
KERNEL_NAME=V60-SUSFS
ADD_LOCALVERSION_TO_FILENAME=true

# --- Toolchain: clang 9/old-compatible for 4.x trees (verified safe) ---
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e
USE_CUSTOM_CLANG=false
USE_LLVM=false
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
EXTRA_CMDS:LD=ld.lld HOSTCFLAGS=-fcommon KCFLAGS=-Wno-error
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

# --- KernelSU: OFFICIAL v0.9.5 (flat layout, matched to SUSFS 1.5.5) ---
KSU_VARIANT=kernelsu
KSU_REF=v0.9.5
KSU_HOOK_MODE=manual
ENABLE_KPM=false
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# --- SUSFS (syscall-level hide) ---
ENABLE_SUSFS=true
SUSFS_BRANCH=kernel-4.19
ENABLE_PATH_UMOUNT=true
ENABLE_HIDE_STUFF=true

# --- One-shot fix for the "device internal problem" boot popup (VINTF) ---
ENABLE_STOCKCONFIG=true

# --- Kconfig tweaks ---
ADD_OVERLAYFS_CONFIG=true
ADD_KPROBES_CONFIG=false
DISABLE_LTO=false
DISABLE_CC_WERROR=true
EXTRA_DEFCONFIG=

# --- AnyKernel3 packaging ---
USE_CUSTOM_ANYKERNEL3=false
NEED_DTBO=false

# --- Do NOT repack boot.img; use AnyKernel3 so current ramdisk/modules are kept ---
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

# --- Runner ---
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
