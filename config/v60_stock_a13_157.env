# ============================================================
# LG V60 ThinQ (timelm) - stock Android 13 - Kernel 4.19.157  ★CORRECTED
# SUSFS + OFFICIAL KernelSU v0.9.5 build profile
# For: 5kind/Droidspaces_Action  (/.github/workflows/build-kernel.yml)
# Place this file at: config/v60_stock_a13.env in the forked Action repo
#
# ★★★ WHY THIS FILE EXISTS (root cause of the first bootloop) ★★★
# The previous build used KERNEL_SOURCE_BRANCH=main, which is kernel 4.19.113.
# The REAL device kernel is 4.19.157-ROFIKKKERNEL, and all 45 vendor .ko modules
# have vermagic "4.19.157-perf+ ... modversions aarch64". With CONFIG_MODVERSIONS=y,
# a 4.19.113 kernel cannot load 4.19.157 vendor modules -> all vendor HALs fail
# -> bootloop. The Rofik repo has a dedicated branch "157" (commit 2ee8302
# "IMPORT LG 4.19.157") which is the correct base. This file switches to it.
#
# Verified:
#   - branch "157": Makefile VERSION=4 PATCHLEVEL=19 SUBLEVEL=157
#   - arch/arm64/configs/vendor/timelm_defconfig exists, uncompressed kernel,
#     CONFIG_KPROBES=y, CONFIG_MODVERSIONS=y (matches device config.gz)
#   - include/linux/mount.h & sched.h are IDENTICAL to the 113 branch (git diff 0),
#     so the existing CAF SUSFS patch (susfs_419_v60.patch) applies unchanged.
#
# IMPORTANT PACKAGING NOTE:
#   Device runs an UNCOMPRESSED kernel with 4 DTBs appended, ramdisk kept.
#   Do NOT force gzip / appended-DTB via EXTRA_DEFCONFIG (that was the old
#   broken approach). Keep uncompressed; AnyKernel3 dump_boot preserves the
#   original 4 DTBs + ramdisk from boot_a. Only the kernel payload changes.
# ============================================================

# --- Kernel source: Rofik 4.19.157 branch (MATCHES device vendor modules) ---
KERNEL_SOURCE=https://github.com/rofikkerneldev/kernel_lgv600tm_4.19
KERNEL_SOURCE_BRANCH=157
KERNEL_CONFIG=vendor/timelm_defconfig
KERNEL_IMAGE_NAME=Image
ARCH=arm64
KERNEL_NAME=V60-SUSFS
ADD_LOCALVERSION_TO_FILENAME=true

# --- Toolchain: clang 14 (r450784e), same as verified working 113 build ---
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e
USE_CUSTOM_CLANG=false
USE_LLVM=false
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
EXTRA_CMDS:LD=ld.lld HOSTCFLAGS=-fcommon KCFLAGS=-Wno-error
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

# --- KernelSU: OFFICIAL v0.9.5 (flat layout, matched to SUSFS 1.5.5) ---
KSU_VARIANT=kernelsu
KSU_REF=v0.9.5
KSU_HOOK_MODE=manual
ENABLE_KPM=false
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# --- SUSFS (syscall-level hide) ---
ENABLE_SUSFS=true
SUSFS_BRANCH=kernel-4.19
ENABLE_PATH_UMOUNT=true
ENABLE_HIDE_STUFF=true

# --- VINTF popup fix ---
ENABLE_STOCKCONFIG=true

# --- Kconfig tweaks ---
ADD_OVERLAYFS_CONFIG=true
ADD_KPROBES_CONFIG=false
DISABLE_LTO=false
DISABLE_CC_WERROR=true
# ★ No version-signature / compression overrides: keep 157 defconfig as-is
#   (uncompressed kernel, matching device). DTBs come from original boot via AnyKernel3.
EXTRA_DEFCONFIG=

# --- AnyKernel3 packaging ---
USE_CUSTOM_ANYKERNEL3=false
NEED_DTBO=false

# --- Do NOT repack boot.img; AnyKernel3 keeps current ramdisk/modules/DTBs ---
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

# --- Runner ---
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
